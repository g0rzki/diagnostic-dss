# Konfiguracja lokalna. Aby zmienić wartości, skopiuj plik:
#   cp .env.example .env
# Bez pliku .env używane są wartości domyślne (takie jak poniżej).

# Baza danych. Zmiana po pierwszym uruchomieniu wymaga resetu bazy:
#   docker compose down -v
POSTGRES_USER=dss
POSTGRES_PASSWORD=dss
POSTGRES_DB=dss

# Host bazy widziany przez aplikację (lokalnie localhost,
# w Dockerze ustawiany w compose.yaml)
POSTGRES_HOST=localhost

# Port bazy na komputerze (zmień, jeśli 5432 jest zajęty)
POSTGRES_PORT=5432
